# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local environment / secrets
.env
.env.*
!.env.example
.idea/

# Local runtime data
qdrant_storage/
neo4j_data/
neo4j_logs/
data/*
!data/.gitkeep
# 공개 샘플: 명시적으로 허용한 예시/데모만 커밋 (사내 원문 실수 커밋 방지)
!data/public/
data/public/*
!data/public/k8s-sample.md
!data/public/aliases.example.yaml
# 비공개 원문: 폴더만 유지하고 내용은 무시 (.gitkeep 제외)
!data/private/
data/private/*
!data/private/.gitkeep
private_reports/

# OS / editor
.DS_Store

# OMC operational artifacts
.omc/

# 제출용 중복 압축본 (docs/*.md와 동일)
docs/*.zip
